# nix/nginx-conf.nix
#
# Generates the OpenResty configuration from the shared constants:
#   - uwsgiParams : the standard uwsgi_params list (user's production file, verbatim)
#   - nginxConf   : nginx.conf with a RAW /api/ location and a CACHED /cached/api/
#                   location (tmpfs uwsgi_cache + Lua-injected Cache-Control).
#
# The cache TTL and the Lua max-age both come from `constants.cacheSeconds`, so
# they cannot drift.
#
{
  pkgs,
  lib,
  constants,
}:

let
  # User's production uwsgi_params, verbatim.
  uwsgiParams = pkgs.writeText "uwsgi_params" ''
    uwsgi_param  QUERY_STRING       $query_string;
    uwsgi_param  REQUEST_METHOD     $request_method;
    uwsgi_param  CONTENT_TYPE       $content_type;
    uwsgi_param  CONTENT_LENGTH     $content_length;
    uwsgi_param  REQUEST_URI        $request_uri;
    uwsgi_param  PATH_INFO          $document_uri;
    uwsgi_param  DOCUMENT_ROOT      $document_root;
    uwsgi_param  SERVER_PROTOCOL    $server_protocol;
    uwsgi_param  REQUEST_SCHEME     $scheme;
    uwsgi_param  HTTPS              $https if_not_empty;
    uwsgi_param  REMOTE_ADDR        $remote_addr;
    uwsgi_param  REMOTE_PORT        $remote_port;
    uwsgi_param  SERVER_PORT        $server_port;
    uwsgi_param  SERVER_NAME        $server_name;
  '';

  nginxConf = pkgs.writeText "nginx.conf" ''
    # Generated by nix/nginx-conf.nix — do not edit by hand.
    # Run workers as root so they can write the tmpfs cache dir; the image ships
    # an /etc/passwd via dockerTools.fakeNss so getpwnam() resolves.
    user  root;
    worker_processes  auto;
    error_log  /dev/stderr  info;
    pid        /var/lib/nginx/nginx.pid;

    events {
      worker_connections  1024;
    }

    http {
      access_log  /dev/stdout;

      # Keep all temp/scratch under the writable prefix (scratch image has no /tmp).
      client_body_temp_path /var/lib/nginx/client_body;
      proxy_temp_path       /var/lib/nginx/proxy;
      fastcgi_temp_path     /var/lib/nginx/fastcgi;
      uwsgi_temp_path       /var/lib/nginx/uwsgi;
      scgi_temp_path        /var/lib/nginx/scgi;

      # tmpfs-backed cache zone (the container mounts /var/cache/nginx as tmpfs).
      uwsgi_cache_path /var/cache/nginx
                       levels=1:2
                       keys_zone=app_cache:${constants.cacheZoneSize}
                       max_size=${constants.cacheMaxSize}
                       inactive=60s
                       use_temp_path=off;

      upstream vms_django {
        server unix:${constants.uwsgiSocket};
      }

      server {
        listen ${toString constants.nginxPort};
        server_name _;

        # ---- RAW: no caching (mirrors the user's production api.conf) --------
        location ^~ /api/ {
          include ${uwsgiParams};
          uwsgi_pass vms_django;
          uwsgi_read_timeout 5h;
          uwsgi_param Host $http_host;
          uwsgi_param X-Forwarded-For $proxy_add_x_forwarded_for;
          uwsgi_param X-Forwarded-Proto $scheme;
          add_header X-Cache-Status "BYPASS" always;
        }

        # ---- CACHED: tmpfs uwsgi_cache; Lua stamps the client headers -------
        # Django emits no cache headers, so uwsgi_cache_valid forces caching;
        # the Lua header_filter adds the visible Cache-Control + X-Cache-Status.
        location ^~ /cached/api/ {
          # Rewrite so PATH_INFO ($document_uri) reaching Django is /api/... —
          # both paths hit the same route.
          rewrite ^/cached(/api/.*)$ $1 break;

          include ${uwsgiParams};
          uwsgi_pass vms_django;
          uwsgi_read_timeout 5h;
          uwsgi_param Host $http_host;
          uwsgi_param X-Forwarded-For $proxy_add_x_forwarded_for;
          uwsgi_param X-Forwarded-Proto $scheme;

          uwsgi_cache app_cache;
          uwsgi_cache_valid 200 ${toString constants.cacheSeconds}s;
          uwsgi_cache_key $request_uri;

          # Stale-while-revalidate: once an entry is stale, serve it immediately
          # and refresh it in a background subrequest instead of blocking the
          # client on the Django round-trip. `updating` covers the refresh
          # in-flight case; error/timeout keep serving stale if Django is down.
          uwsgi_cache_background_update on;
          uwsgi_cache_use_stale updating error timeout;
          uwsgi_cache_lock on;

          header_filter_by_lua_block {
            ngx.header["Cache-Control"] = "public, max-age=${toString constants.cacheSeconds}, stale-while-revalidate=${toString constants.staleWhileRevalidateSeconds}"
            ngx.header["X-Cache-Status"] = ngx.var.upstream_cache_status
          }
        }
      }
    }
  '';
in
{
  inherit nginxConf uwsgiParams;
}
