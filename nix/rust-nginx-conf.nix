# nix/rust-nginx-conf.nix
#
# OpenResty config for the RUST stack. Same two-path caching model as the Python
# stack (nix/nginx-conf.nix), but the Rust daemon speaks plain HTTP/1.1, so this
# uses proxy_pass / proxy_cache_* (the HTTP counterparts of uwsgi_*) over a Unix
# socket with keepalive.
#
# The upstream server list is NOT baked in here: it is generated by the
# container entrypoint into `${rustSocketDir}/upstream.conf` (one `server
# unix:…/wN.sock;` per worker + `keepalive`), so it always matches the actual
# worker count even when `rustWorkers = 0` (auto = nproc).
#
{
  pkgs,
  lib,
  constants,
}:

let
  nginxConf = pkgs.writeText "nginx-rust.conf" ''
    # Generated by nix/rust-nginx-conf.nix — do not edit by hand.
    user  root;
    worker_processes  auto;
    error_log  /dev/stderr  info;
    pid        /var/lib/nginx/nginx.pid;

    events {
      worker_connections  1024;
    }

    http {
      access_log  /dev/stdout;

      # Keep all temp/scratch under the writable prefix.
      client_body_temp_path /var/lib/nginx/client_body;
      proxy_temp_path       /var/lib/nginx/proxy;
      fastcgi_temp_path     /var/lib/nginx/fastcgi;
      uwsgi_temp_path       /var/lib/nginx/uwsgi;
      scgi_temp_path        /var/lib/nginx/scgi;

      # tmpfs-backed cache zone (the container mounts ${constants.rustCacheDir} as tmpfs).
      proxy_cache_path ${constants.rustCacheDir}
                       levels=1:2
                       keys_zone=rust_cache:${constants.cacheZoneSize}
                       max_size=${constants.cacheMaxSize}
                       inactive=60s
                       use_temp_path=off;

      # Per-worker Unix sockets + `keepalive` are written here at startup.
      upstream rust_df {
        include ${constants.rustSocketDir}/upstream.conf;
      }

      server {
        listen ${toString constants.rustNginxPort};
        server_name _;

        # ---- RAW: no caching -------------------------------------------------
        location ^~ /api/ {
          proxy_pass http://rust_df;
          proxy_http_version 1.1;
          proxy_set_header Connection "";
          proxy_read_timeout 5h;
          add_header X-Cache-Status "BYPASS" always;
        }

        # ---- CACHED: tmpfs proxy_cache + Lua headers + stale-while-revalidate -
        location ^~ /cached/api/ {
          # Rewrite so the path reaching the daemon is /api/... (same route).
          rewrite ^/cached(/api/.*)$ $1 break;

          proxy_pass http://rust_df;
          proxy_http_version 1.1;
          proxy_set_header Connection "";
          proxy_read_timeout 5h;

          proxy_cache rust_cache;
          proxy_cache_valid 200 ${toString constants.cacheSeconds}s;
          proxy_cache_key $request_uri;

          # Serve stale immediately and refresh in the background so clients
          # never block on the daemon at TTL expiry.
          proxy_cache_background_update on;
          proxy_cache_use_stale updating error timeout;
          proxy_cache_lock on;

          header_filter_by_lua_block {
            ngx.header["Cache-Control"] = "public, max-age=${toString constants.cacheSeconds}, stale-while-revalidate=${toString constants.staleWhileRevalidateSeconds}"
            ngx.header["X-Cache-Status"] = ngx.var.upstream_cache_status
          }
        }
      }
    }
  '';
in
{
  inherit nginxConf;
}
